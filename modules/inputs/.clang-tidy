---
Checks: >
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  performance-*,
  portability-*,
  modernize-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -modernize-use-trailing-return-type,
  -readability-magic-numbers

HeaderFilterRegex: 'include/inputs/.*'
WarningsAsErrors: '*'
FormatStyle: file
...
